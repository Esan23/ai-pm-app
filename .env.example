# Server-side key for the Claude-backed capture function (netlify/functions/capture.ts).
# Set this in the Netlify dashboard (Site configuration → Environment variables).
# When unset, the app runs in demo mode: capture falls back to a local heuristic.
ANTHROPIC_API_KEY=

# Optional: Supabase auth + persistence. When unset, the app runs guest-only
# and /admin uses the demo gate. Both values are browser-safe.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Server-only (Netlify dashboard, NEVER in the repo or a VITE_ var): powers the
# privileged admin function (netlify/functions/admin-users.ts) — create/invite,
# suspend, role changes + audit writes. Bypasses RLS; treat like a password.
# SUPABASE_SERVICE_ROLE_KEY=
